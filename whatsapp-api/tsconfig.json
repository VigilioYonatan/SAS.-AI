{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "./dist",
        "removeComments": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "baseUrl": "."
    },
    "include": ["src"],
    "exclude": ["node_modules"]
}
