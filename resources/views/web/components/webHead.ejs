<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= locals.$empresa?.name_empresa %> - <%= title %></title>
<meta name="description" content="<%= description  %>">
<!-- METAS -->
<meta name="keywords" content="<%= typeof keywords !== "undefined"?keywords:'sistema web, tienda online, ecommerce'  %>">

<!-- Schema.org markup for Google+ -->
<meta itemprop="name" content="<%= locals.$empresa?.name_empresa %> - <%= title %>">
<meta itemprop="description" content="<%= description %> ">
<meta itemprop="image" content="<%= locals.$empresa?.logo ? printFileWithDimension(locals.$empresa?.logo)[0] :`${BASE_URL}/images/settings/others/logo.webp`   %>">


<!-- Twitter Card data -->
<meta name="twitter:card" content="product">
<meta name="twitter:site" content="@publisher_handle">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%=description|| locals.$empresa ? $empresa.name_empresa:''   %> <%= locals.$empresa ? $empresa.header_cart:'Los mejores productos en un solo lugar'   %> ">
<meta name="twitter:creator" content="@author_handle">
<meta name="twitter:image" content="<%=  typeof favicon !== "undefined"? printFileWithDimension(favicon,100)[0]: locals.$empresa?.logo ? printFileWithDimension(locals.$empresa?.logo)[0] :`${BASE_URL}/images/settings/others/logo.webp`   %>">

<!-- Open Graph data -->
<meta property="og:title" content="<%= title|| locals.$empresa ? $empresa.name_empresa:''   %>">
<meta property="og:type" content="website">
<meta property="og:url" content="/">
<meta property="og:image" content="<%=  typeof ogg_favicon !== "undefined"? printFileWithDimension(ogg_favicon,400)[0]: locals.$empresa?.logo ? printFileWithDimension(locals.$empresa.logo)[0] :`${BASE_URL}/images/settings/others/logo.webp`   %>">
<meta property="og:description" content="<%=description||locals.$empresa ? $empresa.name_empresa:''  %> ofrece lo mejor a un buen precio">
<meta property="og:site_name" content="<%= locals.$empresa ? $empresa.name_empresa:''  %>">
<link rel="manifest" href="/manifest.webmanifest.json">
<script src="/js/tiny-slider.js" defer></script>
<script src="/js/sweet.min.js" defer></script>
<!-- ICONO -->
<link rel="shortcut icon" href="<%=  locals.$empresa.icon ? printFileWithDimension(locals.$empresa.icon,100)[0] :`${BASE_URL}/images/settings/others/logo.webp` %>" type="image/x-icon" />
<%- `<script defer> 
    localStorage.setItem("user", ${JSON.stringify(JSON.stringify(typeof $user !== "undefined" ? $user  ?? null : null  ))});
    localStorage.setItem("empresa", ${JSON.stringify(JSON.stringify(typeof $empresa !== "undefined" ? $empresa  : null))});
    localStorage.setItem("money",${JSON.stringify(JSON.stringify(typeof $money !== "undefined" ? $money  : null))});
    </script>` %>

<style>
  :root {
    --primary: <%=$empresa.setting?.bg_color %>;
    --paper: <%=$empresa.setting?.bg_color_paper %>;
    --light: <%=$empresa.setting?.bg_color_background %>;
  }

  @font-face {
    font-family: 'Font-Thin';
    src: url('<%= `/fonts/${$empresa.setting?.font_face}/${$empresa.setting?.font_face}-Thin.ttf` %>');
    font-display: swap;
  }

  @font-face {
    font-family: 'Font-Light';
    src: url('<%= `/fonts/${$empresa.setting?.font_face}/${$empresa.setting?.font_face}-Light.ttf` %>');
    font-display: swap;
  }

  @font-face {
    font-family: 'Font-Regular';
    src: url('<%= `/fonts/${$empresa.setting?.font_face}/${$empresa.setting?.font_face}-Regular.ttf` %>');
    font-display: swap;
  }

  @font-face {
    font-family: 'Font-Bold';
    src: url('<%= `/fonts/${$empresa.setting?.font_face}/${$empresa.setting?.font_face}-Bold.ttf` %>');
    font-display: swap;
  }

  @font-face {
    font-family: 'Font-Black';
    src: url('<%= `/fonts/${$empresa.setting?.font_face}/${$empresa.setting?.font_face}-Black.ttf` %>');
    font-display: swap;
  }

  .vigilio-modal .modal {
    padding: 0.5rem !important;
    overflow: auto;
    <%=$empresa.setting?.type_border==="circle"? 'border-radius: 0.6rem !important;': 'border-radius: 0rem !important;'%>
  }

  .bg-background-light {
    <%=$empresa.setting?.bg_color_background ? "color: #000000 !important": "color: #FFFFFF !important"%>;
  }

  .bg-background-paper {
    <%=$empresa.setting?.bg_color_paper ? "color: #000000 !important": "color: #FFFFFF !important"%>;
  }
</style>
<%if($empresa.setting?.type_icons ==="animation"){%>
    <script src="https://cdn.lordicon.com/lordicon.js"></script>
  <% }%>
<%- vite  %>
<!-- initial base -->
<initial></initial>