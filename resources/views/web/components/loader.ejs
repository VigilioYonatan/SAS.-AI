<% if($empresa.setting?.type_loader !== "null"){  %>
<div id="loader" class="vigilio-loader-1 opacity-1 bg-background-light  dark:bg-paper-dark">
  <% if($empresa.setting?.type_loader ==="one"){  %>
  <div class="lds-facebook">
    <div></div>
    <div></div>
    <div></div>
  </div>
  <style>
    .vigilio-loader-1 .lds-facebook {
      display: inline-block;
      position: relative;
      width: 80px;
      height: 80px;
    }

    .vigilio-loader-1 .lds-facebook div {
      display: inline-block;
      position: absolute;
      left: 8px;
      width: 16px;
      background: var(--primary);
      animation: lds-facebook 1.2s cubic-bezier(0, 0.5, 0.5, 1) infinite;
    }

    .vigilio-loader-1 .lds-facebook div:nth-child(1) {
      left: 8px;
      animation-delay: -0.24s;
    }

    .vigilio-loader-1 .lds-facebook div:nth-child(2) {
      left: 32px;
      animation-delay: -0.12s;
    }

    .vigilio-loader-1 .lds-facebook div:nth-child(3) {
      left: 56px;
      animation-delay: 0s;
    }

    @keyframes lds-facebook {
      0% {
        top: 8px;
        height: 64px;
      }

      50%,
      100% {
        top: 24px;
        height: 32px;
      }
    }
  </style>
  <% } %>
  <% if($empresa.setting?.type_loader ==="two"){  %>
  <div class="lds-ripple">
    <div></div>
    <div></div>
    <style>
      .vigilio-loader-1 .lds-ripple {
        color: var(--primary);
      }

      .vigilio-loader-1 .lds-ripple,
      .vigilio-loader-1 .lds-ripple div {
        box-sizing: border-box;
      }

      .vigilio-loader-1 .lds-ripple {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 80px;
      }

      .vigilio-loader-1 .lds-ripple div {
        position: absolute;
        border: 4px solid currentColor;
        opacity: 1;
        border-radius: 50%;
        animation: lds-ripple 1s cubic-bezier(0, 0.2, 0.8, 1) infinite;
      }

      .vigilio-loader-1 .lds-ripple div:nth-child(2) {
        animation-delay: -0.5s;
      }

      @keyframes lds-ripple {
        0% {
          top: 36px;
          left: 36px;
          width: 8px;
          height: 8px;
          opacity: 0;
        }

        4.9% {
          top: 36px;
          left: 36px;
          width: 8px;
          height: 8px;
          opacity: 0;
        }

        5% {
          top: 36px;
          left: 36px;
          width: 8px;
          height: 8px;
          opacity: 1;
        }

        100% {
          top: 0;
          left: 0;
          width: 80px;
          height: 80px;
          opacity: 0;
        }
      }
    </style>
  </div>
  <% } %>

  <% if($empresa.setting?.type_loader ==="three"){  %>
  <div class="lds-spinner">
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
    <style>
      .vigilio-loader-1 .lds-spinner,
      .vigilio-loader-1 .lds-spinner div,
      .vigilio-loader-1 .lds-spinner div:after {
        box-sizing: border-box;
        color: var(--primary);
      }

      .vigilio-loader-1 .lds-spinner {
        color: currentColor;
        display: inline-block;
        position: relative;
        width: 80px;
        height: 80px;
      }

      .vigilio-loader-1 .lds-spinner div {
        transform-origin: 40px 40px;
        animation: lds-spinner 1.2s linear infinite;
      }

      .vigilio-loader-1 .lds-spinner div:after {
        content: " ";
        display: block;
        position: absolute;
        top: 3.2px;
        left: 36.8px;
        width: 6.4px;
        height: 17.6px;
        border-radius: 20%;
        background: currentColor;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(1) {
        transform: rotate(0deg);
        animation-delay: -1.1s;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(2) {
        transform: rotate(30deg);
        animation-delay: -1s;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(3) {
        transform: rotate(60deg);
        animation-delay: -0.9s;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(4) {
        transform: rotate(90deg);
        animation-delay: -0.8s;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(5) {
        transform: rotate(120deg);
        animation-delay: -0.7s;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(6) {
        transform: rotate(150deg);
        animation-delay: -0.6s;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(7) {
        transform: rotate(180deg);
        animation-delay: -0.5s;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(8) {
        transform: rotate(210deg);
        animation-delay: -0.4s;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(9) {
        transform: rotate(240deg);
        animation-delay: -0.3s;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(10) {
        transform: rotate(270deg);
        animation-delay: -0.2s;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(11) {
        transform: rotate(300deg);
        animation-delay: -0.1s;
      }

      .vigilio-loader-1 .lds-spinner div:nth-child(12) {
        transform: rotate(330deg);
        animation-delay: 0s;
      }

      @keyframes lds-spinner {
        0% {
          opacity: 1;
        }

        100% {
          opacity: 0;
        }
      }
    </style>
  </div>
  <%}%>
<% if($empresa.setting?.type_loader ==="four"){  %>
  <div class="lds-circle">
    <div></div>
    <style>
      .vigilio-loader-1 .lds-circle,
      .vigilio-loader-1 .lds-circle div {
        box-sizing: border-box;
        color: var(--primary);
      }

      .vigilio-loader-1 .lds-circle {
        display: inline-block;
        transform: translateZ(1px);
      }

      .vigilio-loader-1 .lds-circle>div {
        display: inline-block;
        width: 64px;
        height: 64px;
        margin: 8px;
        background: currentColor;
        border-radius: 50%;
        animation: lds-circle 2.4s cubic-bezier(0, 0.2, 0.8, 1) infinite;
      }

      @keyframes lds-circle {

        0%,
        100% {
          animation-timing-function: cubic-bezier(0.5, 0, 1, 0.5);
        }

        0% {
          transform: rotateY(0deg);
        }

        50% {
          transform: rotateY(1800deg);
          animation-timing-function: cubic-bezier(0, 0.5, 0.5, 1);
        }

        100% {
          transform: rotateY(3600deg);
        }
      }
    </style>
  </div>
  <%}%>
</div>
<style>
  .vigilio-loader-1 {
    width: 100%;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 999999999999;
    position: fixed;
    top: 0;
    left: 0;
    transition: opacity 1s;
  }
</style>
<script defer>
  document.body.classList.add('overflow-hidden');
  document.body.classList.add('h-screen');
  setTimeout(() => {
    const loader = document.getElementById('loader');
    if (loader) {
      loader.classList.add('opacity-0');
      loader.classList.remove('opacity-1');
    }
  }, 1500);

  setTimeout(() => {
    const loader = document.getElementById('loader');
    if (loader) {
      loader.style.display = 'none';
    }
    document.body.classList.remove('overflow-hidden');
    document.body.classList.remove('h-screen');

  }, 2500);
</script>
<% } %>