<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../components/webHead.ejs") %>
</head>

<body class="dark:bg-paper-dark  bg-paper-light overflow-x-hidden">
  <servicios-page title="<%= title  %>" :header="<%= JSON.stringify(header)  %>" :grid_banner_pages="<%=JSON.stringify(grid_banner_pages)  %>">
    <% for(grid of grid_banner_pages){  %>
    <% if(grid.enabled){ %>
    <% if(grid.grid_banner_id){  %>
    <%- grid.grid_banner.html  %>
    <% }else{ %>
    <%- grid.html  %>
    <% } %>
    <% } %>
    <% } %>
  </servicios-page>
</body>

</html>