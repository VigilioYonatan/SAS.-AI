<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.$empresa?.name_empresa %> - <%= title %></title>
  <meta name="description" content="<%= description  %>">
  <!-- METAS -->
  <meta name="robots" content="index, follow">
  <meta name="keywords" content="sistema web, tienda online, ecommerce">

  <!-- Schema.org markup for Google+ -->
  <meta itemprop="name" content="Los mejores productos en un solo lugar">
  <meta itemprop="description" content="<%= locals.$empresa ? $empresa.name_empresa:''   %> ofrece los mejores productos del mercado a un precio bajo">
  <meta itemprop="image" content=""> <!-- puedes poner una imagen de oferta -->


  <!-- Twitter Card data -->
  <meta name="twitter:card" content="product">
  <meta name="twitter:site" content="@publisher_handle">
  <meta name="twitter:title" content="Los mejores productos en un solo lugar">
  <meta name="twitter:description" content="<%= locals.$empresa ? $empresa.name:''   %> ofrece los mejores productos del mercado a un precio bajo">
  <meta name="twitter:creator" content="@author_handle">
  <meta name="twitter:image" content="<%=   locals.$empresa.logo ? printFileWithDimension(locals.$empresa.logo,100)[0] :'' %>"> <!-- puedes poner una imagen de oferta -->

  <!-- Open Graph data -->
  <meta property="og:title" content="Los mejores productos en un solo lugar">
  <meta property="og:type" content="website">
  <meta property="og:url" content="">
  <meta property="og:image" content="<%=   locals.$empresa.logo ? printFileWithDimension(locals.$empresa.logo,100)[0] :'' %>"> <!-- puedes poner una imagen de oferta -->
  <meta property="og:description" content="<%=locals.$empresa ? $empresa.name_empresa:''  %> ofrece los mejores productos del mercado a un precio bajo">
  <meta property="og:site_name" content="<%= locals.$empresa ? $empresa.name_empresa:''  %>">
  <meta property="fb:app_id" content="">
  <link rel="manifest" href="/dist/manifest.webmanifest">
  <!-- ICONO -->
  <link rel="shortcut icon" href="<%=   locals.$empresa.setting?.icon ? printFileWithDimension(locals.$empresa.setting.icon,100)[0] :'' %>" type="image/x-icon" />
  <%- `<script> 
      localStorage.setItem("empresa", ${JSON.stringify(JSON.stringify(typeof $empresa !== "undefined" ? $empresa  : null))});
      localStorage.setItem("user", ${JSON.stringify(JSON.stringify(typeof $user !== "undefined" ? $user  : null))});
      </script>` %>
  <%- vite  %>
  <style>
    :root {
      --primary: <%=$empresa.setting?.bg_color%>
    }
  </style>
  <!-- initial base -->
  <initial></initial>
</head>


<body class="dark:bg-paper-dark  bg-paper-light overflow-x-hidden">
  <about-page :users="<%= JSON.stringify(users)  %>" :productsQuantity="<%= JSON.stringify(productsQuantity)  %>" :header="<%= JSON.stringify(header)  %>" :posts="<%= JSON.stringify(posts)  %>"></about-page>
</body>

</html>