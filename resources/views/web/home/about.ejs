<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../components/webHead.ejs") %>
  <%- include("../components/pixels.ejs")  %>

</head>


<body class="dark:bg-paper-dark  bg-paper-light overflow-x-hidden">
  <%- include("../components/loader.ejs")  %>
  <%- include("../components/script.ejs")  %>
  <about-page :users="<%= JSON.stringify(users)  %>" title="<%= title  %>" :grid_banner_pages="<%= JSON.stringify(grid_banner_pages)  %>" :productsQuantity="<%= JSON.stringify(productsQuantity)  %>" :header="<%= JSON.stringify(header)  %>" :posts="<%= JSON.stringify(posts)  %>" :productServicesQuantity="<%= JSON.stringify(productServicesQuantity)   %>">

    <% for(grid of grid_banner_pages){  %>
    <% if(grid.enabled){ %>
    <% if(grid.grid_banner_id){  %>
    <%- grid.grid_banner.html  %>
    <% }else{ %>
    <%- grid.html  %>
    <% } %>
    <% } %>
    <% } %>
  </about-page>
</body>

</html>