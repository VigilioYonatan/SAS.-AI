<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../components/webHead.ejs") %>

</head>



<body class="dark:bg-paper-dark  bg-paper-light overflow-x-hidden">
  <%- include("../components/pixels.ejs")  %>
  <%- include("../components/loader.ejs")  %>

  <dynamic-page :data="<%= JSON.stringify(data)  %>" :queries="<%= JSON.stringify(queries)  %>" title="<%= title  %>" :grid_banner_pages="<%= JSON.stringify(grid_banner_pages)  %>" :header="<%= JSON.stringify(header)  %>">
    <% for(grid of grid_banner_pages){  %>
    <% if(grid.enabled){ %>
    <% if(grid.grid_banner_id){  %>
    <%- grid.grid_banner.html  %>
    <% }else{ %>
    <%- grid.html  %>
    <% } %>
    <% } %>
    <% } %>
  </dynamic-page>
</body>

</html>