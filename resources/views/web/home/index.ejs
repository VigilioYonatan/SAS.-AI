<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.$information?.name_empresa %> - <%= title %></title>
  <meta name="description" content="<%= description  %>">
  <!-- METAS -->
  <meta name="robots" content="index, follow">
  <meta name="keywords" content="sistema web, tienda online, ecommerce">

  <!-- Schema.org markup for Google+ -->
  <meta itemprop="name" content="Los mejores productos en un solo lugar">
  <meta itemprop="description" content="<%= locals.$information ? $information.name_empresa:''   %> ofrece los mejores productos del mercado a un precio bajo">
  <meta itemprop="image" content=""> <!-- puedes poner una imagen de oferta -->


  <!-- Twitter Card data -->
  <meta name="twitter:card" content="product">
  <meta name="twitter:site" content="@publisher_handle">
  <meta name="twitter:title" content="Los mejores productos en un solo lugar">
  <meta name="twitter:description" content="<%= locals.$information ? $information.name:''   %> ofrece los mejores productos del mercado a un precio bajo">
  <meta name="twitter:creator" content="@author_handle">
  <meta name="twitter:image" content="<%=   locals.$information.logo ? printFileWithDimension(locals.$information.logo,100)[0] :'' %>"> <!-- puedes poner una imagen de oferta -->

  <!-- Open Graph data -->
  <meta property="og:title" content="Los mejores productos en un solo lugar">
  <meta property="og:type" content="website">
  <meta property="og:url" content="">
  <meta property="og:image" content="<%=   locals.$information.logo ? printFileWithDimension(locals.$information.logo,100)[0] :'' %>"> <!-- puedes poner una imagen de oferta -->
  <meta property="og:description" content="<%=locals.$information ? $information.name_empresa:''  %> ofrece los mejores productos del mercado a un precio bajo">
  <meta property="og:site_name" content="<%= locals.$information ? $information.name_empresa:''  %>">
  <meta property="fb:app_id" content="">
  <link rel="manifest" href="/dist/manifest.webmanifest">
  <!-- ICONO -->
  <link rel="shortcut icon" href="<%=   locals.$information.setting?.icon ? printFileWithDimension(locals.$information.setting.icon,100)[0] :'' %>" type="image/x-icon" />
  <%- `<script> 
      localStorage.setItem("information", ${JSON.stringify(JSON.stringify(typeof $information !== "undefined" ? $information  : null))});
      localStorage.setItem("user", ${JSON.stringify(JSON.stringify(typeof $user !== "undefined" ? $user  : null))});
      </script>` %>
  <%- vite  %>
  <style>
    :root {
      --primary: <%=$information.setting?.bg_color%>
    }
  </style>
  <!-- initial base -->
  <initial></initial>
</head>


<body class="dark:bg-paper-dark  bg-paper-light overflow-x-hidden">

  <home-page :header="<%= JSON.stringify(header)  %>" :backgrounds="<%= JSON.stringify(backgrounds)  %>" :posts="<%= JSON.stringify(posts)  %>" :productsOffert6Mapped="<%= JSON.stringify(productsOffert6Mapped)  %>" :productsLatest6Mapped="<%= JSON.stringify(productsLatest6Mapped)  %>" :productMostDiscountMapped="<%= JSON.stringify(productMostDiscountMapped)  %>" :productLatestMapped="<%= JSON.stringify(productLatestMapped)  %>" :getProductsByCategories="<%= JSON.stringify(getProductsByCategories)  %>"></home-page>
</body>

</html>