<!DOCTYPE html>
<html lang="en">
<% 
 const productDescription = product.description ?  product.description.replace(/(<([^>]+)>)/gi, "").slice(0,200) + "...":product.name;
%>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="app-url" content="<%= route("/")  %>">
  <meta name="file-base-url" content="<%= route("/")  %>">
  <meta name="robots" content="index, follow">
  <meta name="description" content="<%= productDescription  %>">
  <meta name="keywords" content="eccomerce, web, inteligencia artificial, ia, ai">
  <!-- Schema.org markup for Google+ -->
  <meta itemprop="name" content="<%= product.name  %>">
  <meta itemprop="description" content="<%=   %>">
  <meta itemprop="image" content="<%=  printImagesProduct(product.images,500)[0]  %>">
  <!-- Twitter Card data -->
  <meta name="twitter:card" content="service">
  <meta name="twitter:site" content="@publisher_handle">
  <meta name="twitter:title" content="<%= product.name  %>">
  <meta name="twitter:description" content="<%= productDescription  %>">
  <meta name="twitter:creator" content="@author_handle">
  <meta name="twitter:image" content="<%=  printImagesProduct(product.images,500)[0]  %>">
  <meta name="twitter:data1" content="<%= locals.$empresa.money.simbolo  %> <%= product.price  %>">
  <meta name="twitter:label1" content="Price">
  <!-- Open Graph data -->
  <meta property="og:title" content="<%= product.name  %>">
  <meta property="og:type" content="og:product">
  <meta property="og:url" content="<%= `/${product.slug}` %>">
  <meta property="og:image" content="<%=  printImagesProduct(product.images,500)[0]  %>">
  <meta property="og:description" content="<%= productDescription  %>">
  <meta property="og:site_name" content="Los mejores productos en un solo lugar">
  <meta property="og:price:amount" content="<%= locals.$empresa.money.simbolo  %>. <%= product.price  %>">
  <meta property="product:condition" content="new">
  <meta property="product:price:amount" content="<%= locals.$empresa.money.simbolo  %>. <%= product.price  %>">
  <meta property="product:retailer_item_id" content="<%= product.slug  %>">
  <meta property="product:price:currency" content="<%= locals.$empresa.money.simbolo  %>">
  <meta property="fb:app_id" content="">
  <title><%= product.name %></title>
  <script src="/js/sweet.min.js"></script>

  <link rel="manifest" href="/manifest.webmanifest.json">
  <!-- ICONO -->
  <link rel="shortcut icon" href="<%=   locals.$empresa.icon ? printFileWithDimension(locals.$empresa.icon,100)[0] :'' %>" type="image/x-icon" />
  <%- `<script> 
      localStorage.setItem("empresa", ${JSON.stringify(JSON.stringify(typeof $empresa !== "undefined" ? $empresa  : null))});
      localStorage.setItem("user", ${JSON.stringify(JSON.stringify(typeof $user !== "undefined" ? $user  : null))});
       localStorage.setItem("money",${JSON.stringify(JSON.stringify(typeof $money !== "undefined" ? $money  : null))});
      </script>` %>
  <%- vite  %>
  <style>
    :root {
      --primary: <%=$empresa.setting?.bg_color%>;
      --paper: <%=$empresa.setting?.bg_color_paper %>;
      --light: <%=$empresa.setting?.bg_color_background %>;
    }

    @font-face {
      font-family: 'Font-Thin';
      src: url('<%= `/fonts/${$empresa.setting?.font_face}/${$empresa.setting?.font_face}-Thin.ttf` %>');
      font-display: swap;
    }

    @font-face {
      font-family: 'Font-Light';
      src: url('<%= `/fonts/${$empresa.setting?.font_face}/${$empresa.setting?.font_face}-Light.ttf` %>');
      font-display: swap;
    }

    @font-face {
      font-family: 'Font-Regular';
      src: url('<%= `/fonts/${$empresa.setting?.font_face}/${$empresa.setting?.font_face}-Regular.ttf` %>');
      font-display: swap;
    }

    @font-face {
      font-family: 'Font-Bold';
      src: url('<%= `/fonts/${$empresa.setting?.font_face}/${$empresa.setting?.font_face}-Bold.ttf` %>');
      font-display: swap;
    }

    @font-face {
      font-family: 'Font-Black';
      src: url('<%= `/fonts/${$empresa.setting?.font_face}/${$empresa.setting?.font_face}-Black.ttf` %>');
      font-display: swap;
    }

    .vigilio-modal .modal {
      padding: 0.5rem !important;
      overflow: auto;
      <%=$empresa.setting?.type_border==="circle"? 'border-radius: 0.6rem !important;': 'border-radius: 0rem !important;'%>
    }
  </style>
  <!-- initial base -->
  <initial></initial>

</head>

<body class="dark:bg-paper-dark  bg-paper-light overflow-x-hidden">
  <%- include("../components/pixels.ejs")  %>
  <%- include("../components/loader.ejs")  %>
  <servicio-page :product="<%= JSON.stringify(product)  %>" category_name="<%= category_name %>" :categoriesproductsrandom="<%= JSON.stringify(categoriesProductsRandom)  %>" :header="<%= JSON.stringify(header)  %>" :totalComments="<%= JSON.stringify(totalComments)  %>">
    <% if( product.description){ %>
    <%-  product.description  %>
    <% } %>
  </servicio-page>
</body>

</html>